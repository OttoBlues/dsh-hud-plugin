{
  "name": "dsh-plugins-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Private DeepSeek Harness Cordis plugin monorepo",
  "workspaces": [
    "plugins/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "test": "node --test",
    "check": "npm run verify && npm run verify:components && npm run verify:channels && npm test",
    "pack:hud": "node scripts/pack-hud.mjs",
    "verify:pack": "node scripts/verify-pack.mjs",
    "verify:channels": "node scripts/verify-channels.mjs",
    "verify:components": "node scripts/verify-components-index.mjs"
  }
}
